<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />

    <!-- Used only by the foreground app (MainActivity) to fetch/verify the asteroid's real
         orbital elements from JPL on demand; the wallpaper service itself never touches the
         network, only reads whatever was last cached by WallpaperPrefs. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/wallpaper_thumbnail"
        android:label="@string/app_name"
        android:theme="@style/Theme.SolarSystemWallpaper"
        android:fullBackupContent="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SolarSystemWallpaper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".SolarSystemWallpaperService"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@drawable/wallpaper_thumbnail"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SolarSystemWallpaper" />

        <receiver
            android:name=".SolarSystemWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/solar_system_widget_info" />
        </receiver>

    </application>

</manifest>
