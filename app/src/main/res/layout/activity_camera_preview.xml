<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.philpf.solarsystemwallpaper.SolarSystemPreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="20dp"
        android:text="@string/camera_preview_title"
        android:textColor="@color/foreground"
        android:textSize="17sp"
        android:textStyle="bold"
        android:shadowColor="@color/background"
        android:shadowRadius="6"
        android:shadowDx="0"
        android:shadowDy="0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/chrome_panel_background"
        android:text="@string/camera_preview_hint"
        android:textColor="@color/foreground"
        android:textSize="11.5sp"
        android:fontFamily="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/chrome_bar_bg"
        android:padding="16dp">

        <Button
            android:id="@+id/resetCameraButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/pill_button_background"
            android:text="@string/reset_camera_button"
            android:textColor="@color/foreground"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/saveCameraButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_button_background_accent"
            android:text="@string/use_this_view_button"
            android:textColor="@color/background"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>

</FrameLayout>
