<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.philpf.solarsystemwallpaper.SolarSystemPreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top capsule: name + data status dot, and the simulated date. Tap for data details. -->
    <com.philpf.solarsystemwallpaper.GlassPanel
        android:id="@+id/hudPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:glassCornerRadius="22dp">

        <LinearLayout
            android:id="@+id/hudContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="11dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/glass_text"
                    android:textSize="16sp" />

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/glass_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </com.philpf.solarsystemwallpaper.GlassPanel>

    <!-- Info card for a tapped body; placed under the top capsule in code -->
    <com.philpf.solarsystemwallpaper.GlassPanel
        android:id="@+id/infoCard"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="96dp"
        android:visibility="gone"
        app:glassCornerRadius="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/infoDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp" />

                <TextView
                    android:id="@+id/infoTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/glass_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/infoClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/close"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/infoSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/glass_text_secondary"
                android:textSize="12.5sp" />

            <LinearLayout
                android:id="@+id/infoRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </com.philpf.solarsystemwallpaper.GlassPanel>

    <!-- Options sheet for the selected tab, shown above the tab bar -->
    <com.philpf.solarsystemwallpaper.GlassPanel
        android:id="@+id/optionsSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:glassCornerRadius="28dp">

        <com.philpf.solarsystemwallpaper.MaxHeightScrollView
            android:id="@+id/optionsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadingEdgeLength="20dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/optionsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="16dp" />
        </com.philpf.solarsystemwallpaper.MaxHeightScrollView>
    </com.philpf.solarsystemwallpaper.GlassPanel>

    <!-- Bottom tab bar: Time / Style / View / Data (segments are added in code) -->
    <com.philpf.solarsystemwallpaper.GlassPanel
        android:id="@+id/tabBarPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:glassCornerRadius="30dp">

        <FrameLayout
            android:id="@+id/tabBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp" />
    </com.philpf.solarsystemwallpaper.GlassPanel>

</FrameLayout>
