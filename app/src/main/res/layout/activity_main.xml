<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.philpf.solarsystemwallpaper.SolarSystemPreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top info capsule: name, simulated date, data source (tap to refresh) -->
    <com.philpf.solarsystemwallpaper.GlassPanel
        android:id="@+id/hudPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:glassCornerRadius="24dp">

        <LinearLayout
            android:id="@+id/hudContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:text="@string/app_name"
                android:textColor="@color/glass_text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/glass_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxWidth="280dp"
                android:textSize="11sp" />
        </LinearLayout>
    </com.philpf.solarsystemwallpaper.GlassPanel>

    <!-- Options sheet, shown above the dock -->
    <com.philpf.solarsystemwallpaper.GlassPanel
        android:id="@+id/optionsSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:glassCornerRadius="30dp">

        <com.philpf.solarsystemwallpaper.MaxHeightScrollView
            android:id="@+id/optionsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadingEdgeLength="24dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/optionsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="6dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp" />
        </com.philpf.solarsystemwallpaper.MaxHeightScrollView>
    </com.philpf.solarsystemwallpaper.GlassPanel>

    <!-- Bottom dock -->
    <com.philpf.solarsystemwallpaper.GlassPanel
        android:id="@+id/dockPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:glassCornerRadius="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/swatchRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="2dp" />

                <FrameLayout
                    android:id="@+id/optionsButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/options">

                    <ImageView
                        android:id="@+id/optionsIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tune" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/setWallpaperButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="@string/set_wallpaper_button"
                android:textSize="16sp" />
        </LinearLayout>
    </com.philpf.solarsystemwallpaper.GlassPanel>

</FrameLayout>
